generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum CourierWorkStatus {
  OFFLINE
  AVAILABLE
  BUSY
  SUSPENDED
}

enum PrincipalType {
  USER
  COURIER
  ADMINISTRATOR
  SYSTEM
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  PENDING_DISPATCH
  PENDING_ACCEPTANCE
  ACCEPTED
  PICKING_UP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  EXCEPTION
}

enum OrderServiceType {
  EXPRESS
  PICKUP
  SAME_CITY
  PURCHASE
  HOTEL
  TICKET
  MOVING
  PHOTO
  RIDE
}

enum PaymentStatus {
  UNPAID
  PENDING_CONFIRM
  PAID
  REFUNDED
}

enum FreightChannel {
  NEXT_DAY
  ECONOMY
}

enum FreightWarehouseStatus {
  AWAITING_INBOUND
  RECEIVED
  DEPARTED
  EXCEPTION
}

enum OfflinePaymentMethod {
  CASH
  WECHAT
  ALIPAY
}

enum SettlementLocation {
  PICKUP
  DROPOFF
}

enum LedgerType {
  ONLINE_REVENUE
  CASH_REVENUE
  DEPOSIT_DEDUCT
  RIDER_PAYOUT
  PLATFORM_CUT
}

enum TicketIssueType {
  DAMAGE
  ATTITUDE
  OVERCHARGE
  OTHER
}

enum OrderAddressType {
  SENDER
  RECIPIENT
}

enum ItemType {
  DOCUMENT
  CLOTHING
  FOOD
  DIGITAL
  DAILY_NECESSITIES
  OTHER
}

enum ShipmentStatus {
  PENDING
  CREATED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXCEPTION
}

enum DeliveryTaskStatus {
  PENDING
  ACCEPTED
  PICKING_UP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXCEPTION
}

enum DeliveryProofType {
  PICKUP_PHOTO
  DELIVERY_PHOTO
  SIGNATURE
  EXCEPTION_PHOTO
}

enum TicketStatus {
  OPEN
  PROCESSING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  SMS
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model User {
  id             String        @id @default(uuid()) @db.Char(36)
  displayName    String        @map("display_name") @db.VarChar(80)
  phoneHash      String?       @unique @map("phone_hash") @db.Char(64)
  phoneEncrypted String?       @map("phone_encrypted") @db.Text
  phoneLast4     String?       @map("phone_last4") @db.Char(4)
  emailHash      String?       @unique @map("email_hash") @db.Char(64)
  emailEncrypted String?       @map("email_encrypted") @db.Text
  emailLast4     String?       @map("email_last4") @db.VarChar(10)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  status         AccountStatus @default(ACTIVE)
  tokenVersion   Int           @default(0) @map("token_version")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?     @map("deleted_at") @db.DateTime(3)

  addresses     UserAddress[]
  orders        ExpressOrder[]
  roles         UserRole[]
  tickets       CustomerServiceTicket[]
  notifications Notification[]

  @@index([status])
  @@map("users")
}

model UserAddress {
  id                String    @id @default(uuid()) @db.Char(36)
  userId            String    @map("user_id") @db.Char(36)
  label             String?   @db.VarChar(30)
  contactName       String    @map("contact_name") @db.VarChar(80)
  phoneHash         String    @map("phone_hash") @db.Char(64)
  phoneEncrypted    String    @map("phone_encrypted") @db.Text
  phoneLast4        String    @map("phone_last4") @db.Char(4)
  countryCode       String    @default("LA") @map("country_code") @db.Char(2)
  country           String    @db.VarChar(80)
  province          String?   @db.VarChar(100)
  city              String    @db.VarChar(100)
  district          String?   @db.VarChar(100)
  village           String?   @db.VarChar(100)
  street            String?   @db.VarChar(150)
  formattedAddress  String?   @map("formatted_address") @db.VarChar(255)
  detail            String    @db.VarChar(255)
  landmark          String?   @db.VarChar(150)
  placeId           String?   @map("place_id") @db.VarChar(180)
  mapProvider       String    @default("MOCK") @map("map_provider") @db.VarChar(30)
  postalCode        String?   @map("postal_code") @db.VarChar(20)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  isDefaultSender   Boolean   @default(false) @map("is_default_sender")
  isDefaultReceiver Boolean   @default(false) @map("is_default_receiver")
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("user_addresses")
}

model Courier {
  id             String            @id @default(uuid()) @db.Char(36)
  displayName    String            @map("display_name") @db.VarChar(80)
  phoneHash      String            @unique @map("phone_hash") @db.Char(64)
  phoneEncrypted String            @map("phone_encrypted") @db.Text
  phoneLast4     String            @map("phone_last4") @db.Char(4)
  passwordHash   String            @map("password_hash") @db.VarChar(255)
  accountStatus  AccountStatus     @default(ACTIVE) @map("account_status")
  workStatus       CourierWorkStatus @default(OFFLINE) @map("work_status")
  riderCode        String?           @unique @map("rider_code") @db.VarChar(40)
  depositBalance   Decimal           @default(0) @map("deposit_balance") @db.Decimal(12, 2)
  depositThreshold Decimal           @default(200) @map("deposit_threshold") @db.Decimal(12, 2)
  tokenVersion     Int               @default(0) @map("token_version")
  serviceAreaId    String?           @map("service_area_id") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?         @map("deleted_at") @db.DateTime(3)

  locations   CourierLocation[]
  orders      ExpressOrder[]
  tasks       DeliveryTask[]
  ledgers     FinanceLedger[]
  serviceArea ServiceArea?      @relation(fields: [serviceAreaId], references: [id])

  @@index([accountStatus, workStatus])
  @@map("couriers")
}

model CourierLocation {
  id         String   @id @default(uuid()) @db.Char(36)
  courierId  String   @map("courier_id") @db.Char(36)
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracyM  Decimal? @map("accuracy_m") @db.Decimal(8, 2)
  heading    Decimal? @db.Decimal(6, 2)
  speedKph   Decimal? @map("speed_kph") @db.Decimal(8, 2)
  recordedAt DateTime @map("recorded_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, recordedAt])
  @@map("courier_locations")
}

model Administrator {
  id           String        @id @default(uuid()) @db.Char(36)
  username     String        @unique @db.VarChar(60)
  displayName  String        @map("display_name") @db.VarChar(80)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(ACTIVE)
  tokenVersion Int           @default(0) @map("token_version")
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime?     @map("deleted_at") @db.DateTime(3)

  roles           AdministratorRole[]
  assignedTickets CustomerServiceTicket[]
  operationLogs   OperationLog[]

  @@index([status])
  @@map("administrators")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  userRoles          UserRole[]
  administratorRoles AdministratorRole[]
  permissions        RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AdministratorRole {
  id              String   @id @default(uuid()) @db.Char(36)
  administratorId String   @map("administrator_id") @db.Char(36)
  roleId          String   @map("role_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([administratorId, roleId])
  @@map("administrator_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id          String        @id @default(uuid()) @db.Char(36)
  subjectType PrincipalType @map("subject_type")
  subjectId   String        @map("subject_id") @db.Char(36)
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime      @map("expires_at") @db.DateTime(3)
  revokedAt   DateTime?     @map("revoked_at") @db.DateTime(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt  DateTime?     @map("last_used_at") @db.DateTime(3)
  userAgent   String?       @map("user_agent") @db.VarChar(255)
  ipHash      String?       @map("ip_hash") @db.Char(64)

  @@index([subjectType, subjectId, revokedAt])
  @@map("refresh_sessions")
}

model VerificationChallenge {
  id          String   @id @default(uuid()) @db.Char(36)
  targetHash  String   @map("target_hash") @db.Char(64)
  channel     String   @db.VarChar(10)
  codeHash    String   @map("code_hash") @db.Char(64)
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.DateTime(3)
  verifiedAt  DateTime? @map("verified_at") @db.DateTime(3)
  consumedAt  DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([targetHash, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("verification_challenges")
}

model ExpressOrder {
  id                String           @id @default(uuid()) @db.Char(36)
  orderNo           String           @unique @map("order_no") @db.VarChar(32)
  userId            String           @map("user_id") @db.Char(36)
  courierId         String?          @map("courier_id") @db.Char(36)
  serviceType       OrderServiceType @map("service_type")
  status            OrderStatus      @default(DRAFT)
  paymentStatus     PaymentStatus    @default(UNPAID) @map("payment_status")
  scheduledPickupAt DateTime?        @map("scheduled_pickup_at") @db.DateTime(3)
  estimatedFee      Decimal          @default(0) @map("estimated_fee") @db.Decimal(12, 2)
  actualFee         Decimal?         @map("actual_fee") @db.Decimal(12, 2)
  couponId          String?          @map("coupon_id") @db.Char(36)
  discountAmount    Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  currency          String           @default("CNY") @db.Char(3)
  remark            String?          @db.VarChar(500)
  extra             Json?
  isMock            Boolean          @default(true) @map("is_mock")
  version           Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  cancelledAt       DateTime?        @map("cancelled_at") @db.DateTime(3)
  completedAt       DateTime?        @map("completed_at") @db.DateTime(3)

  user          User                    @relation(fields: [userId], references: [id])
  courier       Courier?                @relation(fields: [courierId], references: [id])
  addresses     OrderAddress[]
  items         OrderItem[]
  statusLogs    OrderStatusLog[]
  shipment      Shipment?
  task          DeliveryTask?
  tickets         CustomerServiceTicket[]
  notifications   Notification[]
  freightDetail   OrderFreightDetail?
  errandDetail    OrderErrandDetail?
  purchaseDetail  OrderPurchaseDetail?
  serviceRequest  OrderServiceRequest?
  ledgers         FinanceLedger[]

  @@index([userId, createdAt])
  @@index([courierId, status])
  @@index([status, serviceType, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("express_orders")
}

model OrderAddress {
  id             String           @id @default(uuid()) @db.Char(36)
  orderId        String           @map("order_id") @db.Char(36)
  type           OrderAddressType
  contactName    String           @map("contact_name") @db.VarChar(80)
  phoneHash      String           @map("phone_hash") @db.Char(64)
  phoneEncrypted String           @map("phone_encrypted") @db.Text
  phoneLast4     String           @map("phone_last4") @db.Char(4)
  countryCode    String           @default("LA") @map("country_code") @db.Char(2)
  country        String           @db.VarChar(80)
  province       String?          @db.VarChar(100)
  city           String           @db.VarChar(100)
  district       String?          @db.VarChar(100)
  village        String?          @db.VarChar(100)
  street         String?          @db.VarChar(150)
  formattedAddress String?        @map("formatted_address") @db.VarChar(255)
  detail         String           @db.VarChar(255)
  landmark       String?          @db.VarChar(150)
  placeId        String?          @map("place_id") @db.VarChar(180)
  mapProvider    String           @default("MOCK") @map("map_provider") @db.VarChar(30)
  postalCode     String?          @map("postal_code") @db.VarChar(20)
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_addresses")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Char(36)
  orderId       String   @map("order_id") @db.Char(36)
  type          ItemType
  name          String   @db.VarChar(100)
  quantity      Int      @default(1)
  weightKg      Decimal  @map("weight_kg") @db.Decimal(10, 3)
  declaredValue Decimal? @map("declared_value") @db.Decimal(12, 2)
  notes         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusLog {
  id           String        @id @default(uuid()) @db.Char(36)
  orderId      String        @map("order_id") @db.Char(36)
  fromStatus   OrderStatus?  @map("from_status")
  toStatus     OrderStatus   @map("to_status")
  operatorType PrincipalType @map("operator_type")
  operatorId   String?       @map("operator_id") @db.Char(36)
  reason       String?       @db.VarChar(255)
  requestId    String?       @map("request_id") @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

model Shipment {
  id           String         @id @default(uuid()) @db.Char(36)
  orderId      String         @unique @map("order_id") @db.Char(36)
  shipmentNo   String         @unique @map("shipment_no") @db.VarChar(40)
  providerCode String         @map("provider_code") @db.VarChar(40)
  providerRef  String?        @map("provider_ref") @db.VarChar(100)
  status       ShipmentStatus @default(PENDING)
  isMock       Boolean        @default(true) @map("is_mock")
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  order          ExpressOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingEvents TrackingEvent[]

  @@index([status, updatedAt])
  @@map("shipments")
}

model TrackingEvent {
  id          String   @id @default(uuid()) @db.Char(36)
  shipmentId  String   @map("shipment_id") @db.Char(36)
  status      String   @db.VarChar(50)
  description String   @db.VarChar(255)
  location    String?  @db.VarChar(150)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  occurredAt  DateTime @map("occurred_at") @db.DateTime(3)
  isManual    Boolean  @default(false) @map("is_manual")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("tracking_events")
}

model DeliveryTask {
  id          String             @id @default(uuid()) @db.Char(36)
  orderId     String             @unique @map("order_id") @db.Char(36)
  courierId   String?            @map("courier_id") @db.Char(36)
  status      DeliveryTaskStatus @default(PENDING)
  acceptedAt  DateTime?          @map("accepted_at") @db.DateTime(3)
  pickupAt    DateTime?          @map("pickup_at") @db.DateTime(3)
  deliveredAt DateTime?          @map("delivered_at") @db.DateTime(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  order   ExpressOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier?        @relation(fields: [courierId], references: [id])
  proofs  DeliveryProof[]

  @@index([courierId, status])
  @@index([status, createdAt])
  @@map("delivery_tasks")
}

model DeliveryProof {
  id         String            @id @default(uuid()) @db.Char(36)
  taskId     String            @map("task_id") @db.Char(36)
  type       DeliveryProofType
  storageKey String            @map("storage_key") @db.VarChar(255)
  mimeType   String            @map("mime_type") @db.VarChar(100)
  sizeBytes  Int               @map("size_bytes")
  isPrivate  Boolean           @default(true) @map("is_private")
  uploadedBy String            @map("uploaded_by") @db.Char(36)
  createdAt  DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  task DeliveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("delivery_proofs")
}

model ServiceArea {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  countryCode String   @default("LA") @map("country_code") @db.Char(2)
  country     String   @default("老挝") @db.VarChar(80)
  province    String?  @db.VarChar(100)
  region      String?  @db.VarChar(100)
  boundary    Json
  centerLatitude  Decimal? @map("center_latitude") @db.Decimal(10, 7)
  centerLongitude Decimal? @map("center_longitude") @db.Decimal(10, 7)
  mapProvider String @default("MOCK") @map("map_provider") @db.VarChar(30)
  coordinateStatus String @default("MOCK_UNVERIFIED") @map("coordinate_status") @db.VarChar(30)
  isDefault Boolean @default(false) @map("is_default")
  currency String @default("LAK") @db.Char(3)
  timezone String @default("Asia/Vientiane") @db.VarChar(60)
  operationsCenterName String? @map("operations_center_name") @db.VarChar(120)
  userDisplayName String? @map("user_display_name") @db.VarChar(120)
  courierDisplayName String? @map("courier_display_name") @db.VarChar(120)
  outOfAreaMessage String @default("当前位置暂不在服务范围内") @map("out_of_area_message") @db.VarChar(160)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  pricingRules PricingRule[]
  couriers Courier[]

  @@index([countryCode, isActive])
  @@map("service_areas")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_settings")
}

model PricingRule {
  id            String           @id @default(uuid()) @db.Char(36)
  serviceAreaId String?          @map("service_area_id") @db.Char(36)
  name          String           @db.VarChar(100)
  serviceType   OrderServiceType @map("service_type")
  baseFee       Decimal          @map("base_fee") @db.Decimal(12, 2)
  perKmFee      Decimal          @default(0) @map("per_km_fee") @db.Decimal(12, 2)
  perKgFee      Decimal          @default(0) @map("per_kg_fee") @db.Decimal(12, 2)
  minimumFee    Decimal          @map("minimum_fee") @db.Decimal(12, 2)
  currency      String           @default("LAK") @db.Char(3)
  isActive      Boolean          @default(true) @map("is_active")
  effectiveFrom DateTime         @map("effective_from") @db.DateTime(3)
  effectiveTo   DateTime?        @map("effective_to") @db.DateTime(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  serviceArea ServiceArea? @relation(fields: [serviceAreaId], references: [id])

  @@index([serviceType, isActive, effectiveFrom])
  @@map("pricing_rules")
}

model CustomerServiceTicket {
  id              String         @id @default(uuid()) @db.Char(36)
  ticketNo        String         @unique @map("ticket_no") @db.VarChar(32)
  userId          String         @map("user_id") @db.Char(36)
  orderId         String?        @map("order_id") @db.Char(36)
  assignedAdminId String?        @map("assigned_admin_id") @db.Char(36)
  issueType       TicketIssueType @default(OTHER) @map("issue_type")
  subject         String          @db.VarChar(150)
  description     String          @db.Text
  status          TicketStatus    @default(OPEN)
  priority        TicketPriority  @default(NORMAL)
  penaltyAmount   Decimal         @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  adminNote       String?         @map("admin_note") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  resolvedAt      DateTime?      @map("resolved_at") @db.DateTime(3)

  user          User           @relation(fields: [userId], references: [id])
  order         ExpressOrder?  @relation(fields: [orderId], references: [id])
  assignedAdmin Administrator? @relation(fields: [assignedAdminId], references: [id])

  @@index([status, priority, createdAt])
  @@map("customer_service_tickets")
}

model Notification {
  id        String              @id @default(uuid()) @db.Char(36)
  userId    String              @map("user_id") @db.Char(36)
  orderId   String?             @map("order_id") @db.Char(36)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String              @db.VarChar(120)
  content   String              @db.VarChar(500)
  metadata  Json?
  sentAt    DateTime?           @map("sent_at") @db.DateTime(3)
  readAt    DateTime?           @map("read_at") @db.DateTime(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order ExpressOrder? @relation(fields: [orderId], references: [id])

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model OperationLog {
  id              String        @id @default(uuid()) @db.Char(36)
  administratorId String?       @map("administrator_id") @db.Char(36)
  operatorType    PrincipalType @map("operator_type")
  operatorId      String?       @map("operator_id") @db.Char(36)
  action          String        @db.VarChar(100)
  resourceType    String        @map("resource_type") @db.VarChar(80)
  resourceId      String?       @map("resource_id") @db.Char(36)
  requestId       String?       @map("request_id") @db.VarChar(64)
  ipHash          String?       @map("ip_hash") @db.Char(64)
  result          String        @db.VarChar(30)
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  administrator Administrator? @relation(fields: [administratorId], references: [id])

  @@index([resourceType, resourceId, createdAt])
  @@index([operatorType, operatorId, createdAt])
  @@map("operation_logs")
}

model OrderFreightDetail {
  id                 String                  @id @default(uuid()) @db.Char(36)
  orderId            String                  @unique @map("order_id") @db.Char(36)
  channel            FreightChannel
  domesticTrackingNo String                  @map("domestic_tracking_no") @db.VarChar(64)
  actualWeight       Decimal?                @map("actual_weight") @db.Decimal(8, 2)
  volumeWeight       Decimal?                @map("volume_weight") @db.Decimal(8, 2)
  billedWeight       Decimal?                @map("billed_weight") @db.Decimal(8, 2)
  lengthCm           Decimal?                @map("length_cm") @db.Decimal(8, 2)
  widthCm            Decimal?                @map("width_cm") @db.Decimal(8, 2)
  heightCm           Decimal?                @map("height_cm") @db.Decimal(8, 2)
  warehouseStatus    FreightWarehouseStatus  @default(AWAITING_INBOUND) @map("warehouse_status")
  isUnclaimed        Boolean                 @default(false) @map("is_unclaimed")
  claimedByUserId    String?                 @map("claimed_by_user_id") @db.Char(36)
  thirdPartyCode     String?                 @map("third_party_code") @db.VarChar(64)
  createdAt          DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([domesticTrackingNo])
  @@index([warehouseStatus, isUnclaimed])
  @@map("order_freight_details")
}

model OrderErrandDetail {
  id               String                 @id @default(uuid()) @db.Char(36)
  orderId          String                 @unique @map("order_id") @db.Char(36)
  deliveryAreaType Int                    @map("delivery_area_type") @db.TinyInt
  weightTier       Int                    @map("weight_tier") @db.TinyInt
  itemDescription  String                 @map("item_description") @db.VarChar(255)
  paymentMethod    OfflinePaymentMethod   @map("payment_method")
  settlementLoc    SettlementLocation     @map("settlement_loc")
  pickupImgKey     String?                @map("pickup_img_key") @db.VarChar(255)
  paymentImgKey    String?                @map("payment_img_key") @db.VarChar(255)
  cancelReason     String?                @map("cancel_reason") @db.VarChar(255)
  timeoutAt        DateTime?              @map("timeout_at") @db.DateTime(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([deliveryAreaType, weightTier])
  @@map("order_errand_details")
}

model OrderPurchaseDetail {
  id            String    @id @default(uuid()) @db.Char(36)
  orderId       String    @unique @map("order_id") @db.Char(36)
  productUrl    String    @map("product_url") @db.VarChar(1000)
  quoteAmount   Decimal?  @map("quote_amount") @db.Decimal(12, 2)
  serviceFee    Decimal?  @map("service_fee") @db.Decimal(12, 2)
  adminNote     String?   @map("admin_note") @db.VarChar(500)
  quotedAt      DateTime? @map("quoted_at") @db.DateTime(3)
  confirmedAt   DateTime? @map("confirmed_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_purchase_details")
}

model OrderServiceRequest {
  id          String   @id @default(uuid()) @db.Char(36)
  orderId     String   @unique @map("order_id") @db.Char(36)
  contactName String   @map("contact_name") @db.VarChar(80)
  phoneLast4  String   @map("phone_last4") @db.Char(4)
  phoneHash   String   @map("phone_hash") @db.Char(64)
  phoneEncrypted String @map("phone_encrypted") @db.Text
  detail      String   @db.VarChar(1000)
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  order ExpressOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_service_requests")
}

model FreightRule {
  id          String         @id @default(uuid()) @db.Char(36)
  channel     FreightChannel @unique
  baseWeight  Decimal        @map("base_weight") @db.Decimal(8, 2)
  basePrice   Decimal        @map("base_price") @db.Decimal(8, 2)
  stepWeight  Decimal        @map("step_weight") @db.Decimal(8, 2)
  stepPrice   Decimal        @map("step_price") @db.Decimal(8, 2)
  currency    String         @default("CNY") @db.Char(3)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("freight_rules")
}

model FinanceLedger {
  id           String     @id @default(uuid()) @db.Char(36)
  orderId      String?    @map("order_id") @db.Char(36)
  courierId    String?    @map("courier_id") @db.Char(36)
  amount       Decimal    @db.Decimal(12, 2)
  type         LedgerType
  batchDate    String     @map("batch_date") @db.VarChar(32)
  platformCut  Decimal    @default(0) @map("platform_cut") @db.Decimal(12, 2)
  riderCut     Decimal    @default(0) @map("rider_cut") @db.Decimal(12, 2)
  note         String?    @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  order   ExpressOrder? @relation(fields: [orderId], references: [id])
  courier Courier?      @relation(fields: [courierId], references: [id])

  @@index([batchDate, type])
  @@index([courierId, createdAt])
  @@map("finance_ledgers")
}
