NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Client-side public configuration only. Never place a secret in a VITE_* value.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PROVIDER_MODE=mock
VITE_USER_APP_PORT=5173
VITE_COURIER_APP_PORT=5174
VITE_ADMIN_WEB_PORT=5175

MYSQL_PORT=3306
MYSQL_DATABASE=express_platform
MYSQL_USER=express_app
MYSQL_PASSWORD=local_only_change_me_app
MYSQL_ROOT_PASSWORD=local_only_change_me_root
DATABASE_URL=mysql://express_app:local_only_change_me_app@127.0.0.1:3306/express_platform

REDIS_PORT=6379
REDIS_PASSWORD=local_only_change_me_redis
REDIS_URL=redis://:local_only_change_me_redis@127.0.0.1:6379

JWT_ACCESS_SECRET=local_only_change_me_access_32_chars_minimum
JWT_REFRESH_SECRET=local_only_change_me_refresh_32_chars_minimum
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PHONE_HASH_KEY=local_only_change_me_phone_hash_key
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

PROVIDER_MODE=mock
KUAIDI100_ENABLED=false
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_SECRET=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Local demonstration accounts only. These passwords must never be reused in production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=DemoAdmin!2026
SEED_USER_PHONE=+8562099990001
SEED_USER_PASSWORD=DemoUser!2026
SEED_COURIER_PHONE=+8562099990002
SEED_COURIER_PASSWORD=DemoCourier!2026
